{
  "name": "@a11y-hud/angular",
  "version": "1.0.0-rc.0",
  "description": "Angular adapter for a11y-hud — run axe-core accessibility audits in your Angular app with no DevTools required.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "dev": "ng-packagr -p ng-package.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "a11y-hud": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0 <23.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "ng-packagr": "^21.2.7",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "zone.js": "^0.16.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "homepage": "https://github.com/arthurvasconcelos/a11y-hud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurvasconcelos/a11y-hud.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/arthurvasconcelos/a11y-hud/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "axe",
    "axe-core",
    "wcag",
    "angular",
    "dev-tools",
    "overlay",
    "hud"
  ],
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  }
}
